# Database (Supabase). The service role key is server-only: never expose it to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Owner login. ADMIN_PASSWORD needs 8+ characters, ADMIN_SECRET 16+.
ADMIN_PASSWORD=choose-a-long-password
ADMIN_SECRET=choose-a-long-random-string
IP_SALT=any-random-string

# Demo mode: lets visitors open the admin without a password. Sample-data deployments only.
DEMO_MODE=false

# Authorizes the daily maintenance job (Vercel Cron sends it as a bearer token).
CRON_SECRET=choose-a-long-random-string

# Optional: any OpenAI-compatible endpoint. Leave LLM_API_KEY empty to run in FAQ lookup mode.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
